AGENTSE_HOST=0.0.0.0
AGENTSE_PORT=8080
AGENTSE_LOG_LEVEL=INFO

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENTSE_MODEL=gemma2:2b
AGENTSE_EVAL_MODELS=llama3.2:1b,qwen2.5:1.5b,gemma2:2b
AGENTSE_TEMPERATURE=0.2
AGENTSE_MAX_TOKENS=512
AGENTSE_TIMEOUT_S=90

# Routing: hybrid | llm | policy
AGENTSE_ROUTING_MODE=hybrid
AGENTSE_MAX_STEPS=8

# Memory
AGENTSE_WORKSPACE=./workspace
AGENTSE_DATA_DIR=./data
AGENTSE_EMBED_MODEL=nomic-embed-text
AGENTSE_MEMORY_DECAY=0.97

# Isolation
AGENTSE_SANDBOX_URL=http://127.0.0.1:8090
AGENTSE_SANDBOX_TIMEOUT_S=8
AGENTSE_SANDBOX_ENABLED=true

# Observability
AGENTSE_OTEL_ENDPOINT=http://127.0.0.1:4318
AGENTSE_LANGFUSE_HOST=http://127.0.0.1:3000
AGENTSE_LANGFUSE_PUBLIC_KEY=
AGENTSE_LANGFUSE_SECRET_KEY=
AGENTSE_PROMETHEUS_PORT=9108
AGENTSE_ENABLE_LANGFUSE=false
