FROM python:3.12-alpine

WORKDIR /sandbox
COPY deploy/sandbox_server.py /sandbox/server.py

RUN adduser -D -u 10002 box \
    && pip install --no-cache-dir fastapi==0.115.6 uvicorn==0.32.1 \
    && chmod 555 /sandbox/server.py

USER box
EXPOSE 8090
CMD ["python", "-c", "import uvicorn; uvicorn.run('server:app', host='0.0.0.0', port=8090)"]
